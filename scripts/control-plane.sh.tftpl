#!/bin/bash
set -euxo pipefail

${node_prep}

kubeadm init \
  --pod-network-cidr=${pod_cidr} \
  --apiserver-cert-extra-sans=127.0.0.1
export KUBECONFIG=/etc/kubernetes/admin.conf

# Calico: operator, then the Installation (VXLAN always, BGP off)
CALICO_URL=https://raw.githubusercontent.com/projectcalico/calico/${calico_version}/manifests
kubectl create -f $CALICO_URL/operator-crds.yaml
kubectl create -f $CALICO_URL/tigera-operator.yaml
kubectl wait --for=condition=Established crd --all --timeout=120s

curl $CURL_OPTS -o /root/custom-resources.yaml $CALICO_URL/custom-resources.yaml
sed -i 's/encapsulation: VXLANCrossSubnet/encapsulation: VXLAN/' /root/custom-resources.yaml
sed -i 's/^\( *\)calicoNetwork:$/&\n\1  bgp: Disabled/' /root/custom-resources.yaml
grep -q 'encapsulation: VXLAN$' /root/custom-resources.yaml
grep -q 'bgp: Disabled' /root/custom-resources.yaml
kubectl create -f /root/custom-resources.yaml

set +x 
JOIN_COMMAND=$(kubeadm token create --print-join-command)
aws ssm put-parameter --region ${aws_region} --name ${join_parameter} \
  --type SecureString --overwrite --value "$JOIN_COMMAND" > /dev/null
set -x
echo "Join command published to ${join_parameter}"